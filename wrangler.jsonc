{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "killer-sudoku",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  // ランキング API(/api/*)。それ以外は dist/ の静的ファイルをそのまま返す。
  "main": "worker/index.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  // 毎日 0:05(日本時間)。月が変わったら前月の月間ランキングを Discord に通知する。
  // Webhook の URL はシークレット: `npx wrangler secret put DISCORD_WEBHOOK_URL`
  "triggers": {
    "crons": ["5 15 * * *"]
  },
  "vars": {
    "SITE_URL": "https://killer-sudoku.a1danwa.workers.dev/"
  },
  // `npx wrangler d1 create killer-sudoku` で作ったデータベース。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "killer-sudoku",
      "database_id": "1a44ecfd-fb69-4616-99d3-86c6c7963d45",
      "migrations_dir": "migrations"
    }
  ]
}
